{
  "name": "budgie",
  "version": "0.1.0",
  "private": true,
  "description": "Budgie: planner, life goals and a twice-weekly digest of opportunities. Vue + Vite, deployed on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "check": "vite build",
    "test": "node tests/smoke.cjs",
    "test:accounts": "node tests/accounts.cjs",
    "test:unit": "node tests/unit/run.mjs",
    "test:responsive": "node tests/responsive.cjs",
    "dev:api": "wrangler dev --local --port 8787"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "^1.64.1",
    "vite": "^7.3.7",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.44"
  },
  "type": "module"
}
