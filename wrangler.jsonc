{
  // Budgie is a static Vue site. Cloudflare's GitHub integration deploys every
  // push to main by running `npx wrangler deploy`, which first runs the build
  // command below, so the dashboard's own build-command field can stay empty.
  "name": "budgie",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
